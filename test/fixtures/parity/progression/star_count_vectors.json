                "role": "shopper",
                "finished_at": "2026-07-18T10:05:00Z",
                "archived_at": "2026-07-18T10:06:00Z"
              }
            },
            "plan_roles": {
              "r1": {
                "id": "r1",
                "name": "Shopper",
                "goal": null,
                "goals": [
                  {"id": "g1", "goal_slug": "s1", "description": "Greet the baker"},
                  {"id": "g2", "goal_slug": "s2", "description": "Ask the price"},
                  {"id": "g3", "goal_slug": "s3", "description": "Pay for the bread"}
                ]
              }
            },
            "awarded_goals": {"awards": {"r1": ["s1", "s2", "s3"]}, "legacy_flat_goal_ids": []}
          },
          {
            "activity_id": "a1",
            "roles": {
              "r1": {
                "id": "r1",
                "user_id": "@student:pangea.chat",
                "role": "shopper",
                "finished_at": "2026-07-19T09:00:00Z",
                "archived_at": "2026-07-19T09:01:00Z"
              }
            },
            "plan_roles": {
              "r1": {
                "id": "r1",
                "name": "Shopper",
                "goal": null,
                "goals": [
                  {"id": "g1", "goal_slug": "s1", "description": "Greet the baker"},
                  {"id": "g2", "goal_slug": "s2", "description": "Ask the price"},
                  {"id": "g3", "goal_slug": "s3", "description": "Pay for the bread"}
                ]
              }
            },
            "awarded_goals": {"awards": {"r1": ["s1"]}, "legacy_flat_goal_ids": []}
          }
        ]
      },
      "expect": {
        "own_stars_per_session": [3, 1],
        "stars_by_activity": {"a1": 3},
        "earnable_by_activity": {"a1": 3}
      }
    },
