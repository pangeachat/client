{
  "about": "Inputs for the analytics parity goldens. Each case is the raw content of a learner's analytics room: construct events (content exactly as stored in Matrix), the blocked constructs from the analytics-settings state event, the activity room ids state event, and the language's published xp_offset. A use with no timeStamp gets one assigned by the generator (see analytics_goldens.dart); `_repeat` expands a use N times. goldens.json records every case fully expanded, so consumers never need these conventions.",
  "cases": [
    {
      "name": "other_category_and_strict_identity",
      "description": "Uses with no category, an empty category, an unknown morph feature, an empty lemma and a deprecated 'grammar' construct type. 'other' is not a wildcard: casa/noun and casa/other are different constructs. Invalid constructs stay in the teacher summary but not in the learner counts.",
      "events": [
        {
          "uses": [
            {"useType": "corPA", "lemma": "casa", "constructType": "vocab", "categories": "noun"},
            {"useType": "corPA", "lemma": "casa", "constructType": "vocab"},
            {"useType": "corPA", "lemma": "mesa", "constructType": "vocab", "categories": ""},
            {"useType": "corPA", "lemma": "", "constructType": "vocab", "categories": "noun"},
            {"useType": "corM", "lemma": "Past", "constructType": "morph", "categories": "Tense"},
            {"useType": "corM", "lemma": "Weird", "constructType": "morph", "categories": "notafeature"},
            {"useType": "corM", "lemma": "Old", "constructType": "grammar", "categories": "Tense"}
          ]
